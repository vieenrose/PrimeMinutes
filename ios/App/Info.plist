<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>tw.com.pesi.primeminutes</string>
<key>CFBundleName</key><string>PrimeMinutes</string>
<key>CFBundleDisplayName</key><string>Prime Minutes</string>
<key>CFBundleExecutable</key><string>PrimeMinutes</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>21</string>
<key>CFBundleShortVersionString</key><string>0.55.0</string>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hant</string><string>zh-Hans</string></array>
<key>UIBackgroundModes</key><array><string>audio</string><string>fetch</string><string>processing</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>tw.com.pesi.primeminutes.queue</string><string>tw.com.pesi.primeminutes.subcheck</string><string>tw.com.pesi.primeminutes.process.*</string></array>
<!-- YES: Files (where AirDrop leaves a .pmin in Downloads) hands a tapped meeting to the owner app only if it opens
     documents in place; NO showed a Quick Look preview and never launched the app. The URL is security-scoped and the
     file is the user's: Imports.open reads it under a coordinated read and copies it, never moves or deletes it.
     No UIFileSharingEnabled / UISupportsDocumentBrowser: Documents stays private, the app is no document browser. -->
<key>LSSupportsOpeningDocumentsInPlace</key><true/>
<key>CFBundleDocumentTypes</key><array><dict><key>CFBundleTypeName</key><string>Prime Minutes meeting</string><key>CFBundleTypeRole</key><string>Editor</string><key>LSHandlerRank</key><string>Owner</string><key>LSItemContentTypes</key><array><string>tw.com.pesi.primeminutes.session</string></array></dict><dict><key>CFBundleTypeName</key><string>Audio</string><key>CFBundleTypeRole</key><string>Viewer</string><key>LSHandlerRank</key><string>Alternate</string><key>LSItemContentTypes</key><array><string>public.audio</string><string>public.movie</string></array></dict></array>
<!-- A shared meeting (.pmin, MPEG-4 inside): our own type, so AirDrop hands it to the app and never to an audio player. -->
<key>UTExportedTypeDeclarations</key><array><dict><key>UTTypeIdentifier</key><string>tw.com.pesi.primeminutes.session</string><key>UTTypeDescription</key><string>Prime Minutes meeting</string><key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array><key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>pmin</string></array><key>public.mime-type</key><array><string>application/vnd.primeminutes.session</string></array></dict></dict></array>
<key>MinimumOSVersion</key><string>17.0</string>
<key>UILaunchScreen</key><dict/>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundleIcons</key><dict><key>CFBundlePrimaryIcon</key><dict><key>CFBundleIconName</key><string>AppIcon</string><key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array></dict></dict>
<!-- Podcast enclosures are often plain http:// on hosts that cannot be listed, so cleartext stays allowed in
     general (as Android's network_security_config); the sensitive fetches (models, updates) are HTTPS-only. -->
<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/>
	<key>NSExceptionDomains</key><dict>
		<key>huggingface.co</key><dict><key>NSIncludesSubdomains</key><true/><key>NSExceptionAllowsInsecureHTTPLoads</key><false/></dict>
		<key>hf.co</key><dict><key>NSIncludesSubdomains</key><true/><key>NSExceptionAllowsInsecureHTTPLoads</key><false/></dict>
	</dict></dict>
	<key>NSContactsUsageDescription</key>
	<string>The people you name in your meetings are your contacts: Prime Minutes adds them there and reads their e-mail addresses to send minutes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Prime Minutes transcribes your meetings from the microphone, on the device.</string>
</dict></plist>
