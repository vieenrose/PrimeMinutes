diff --git a/src/xasr.h b/src/xasr.h
index 81b9b804..85acbf76 100644
--- a/src/xasr.h
+++ b/src/xasr.h
@@ -37,6 +37,14 @@ char* xasr_transcribe(struct xasr_context* ctx, const float* samples, int n_samp
 // full transcript so far (malloc'd, append-only). flush = end of input: the
 // tail padding is added and the remaining frames are decoded. Pieces of any
 // size give the same tokens as one call.
+// External chunk encoder (nemo-x-asr-diarizer LiteRT path). When set, run_chunks() calls fn once per
+// decode step instead of the ggml chunk graph; the encoder keeps its own streaming state. fn receives
+// the T x feature_dim window and writes enc_frames x enc_dim floats. reset is called on stream reset.
+typedef int (*xasr_chunk_fn)(void* user, const float* feats, int T, int feat_dim,
+                             float* enc_out, int enc_frames, int enc_dim);
+typedef void (*xasr_reset_fn)(void* user);
+void xasr_set_external_chunk_encoder(struct xasr_context* ctx, xasr_chunk_fn fn, xasr_reset_fn reset, void* user);
+
 struct xasr_stream;
 struct xasr_stream* xasr_stream_init(struct xasr_context* ctx);
 char* xasr_stream_accept(struct xasr_stream* s, const float* samples, int n_samples, bool flush);
