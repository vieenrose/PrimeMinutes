 namespace {
@@ -899,6 +903,20 @@ bool run_chunks(xasr_context* c, std::vector<uint8_t>& meta, enc_state& st, cons
     const int S = (int)hp.dims.size();
     if (*pos + G.T >= n_rows)
         return true;
+    if (c->ext_fn) {
+        // Same window/step arithmetic as the ggml loop below; the external encoder owns the caches.
+        const int F = hp.feature_dim, Eo = G.chunk / 2, Ed = hp.joiner_dim;
+        std::vector<float> enc_step((size_t)Eo * Ed);
+        for (; *pos + G.T < n_rows; *pos += G.decode_chunk_len) {
+            if (!c->ext_fn(c->ext_user, feats + (size_t)*pos * F, G.T, F, enc_step.data(), Eo, Ed)) {
+                fprintf(stderr, "xasr: external chunk encoder failed\n");
+                return false;
+            }
+            st.processed += G.chunk;
+            enc_out.insert(enc_out.end(), enc_step.begin(), enc_step.end());
+        }
+        return true;
+    }
     const bool dump = dumps != nullptr;
