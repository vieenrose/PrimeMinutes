@@ -293,6 +293,10 @@ struct xasr_context {
     ggml_cgraph* chunk_gf = nullptr;
     ggml_context* chunk_ctx = nullptr;
     std::vector<std::vector<float>> pes_cache;
+    // external chunk encoder (see xasr_set_external_chunk_encoder); null = ggml graph
+    xasr_chunk_fn ext_fn = nullptr;
