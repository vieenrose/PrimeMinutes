<?xml version="1.0" encoding="utf-8"?>
<!-- The record widget: one round red button; while recording ■ and the elapsed time under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_record_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/rec_entry_start"
        android:src="@drawable/widget_record_start" />

    <Chronometer
        android:id="@+id/widget_record_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_record_time_bg"
        android:paddingHorizontal="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
