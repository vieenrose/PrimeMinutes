<?xml version="1.0" encoding="utf-8"?>
<!-- Record widget, recording: the red button with a white ■ (tap = stop and save). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <size android:width="52dp" android:height="52dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval"><solid android:color="#FFE53935" /></shape>
    </item>
    <item android:bottom="17dp" android:left="17dp" android:right="17dp" android:top="17dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
