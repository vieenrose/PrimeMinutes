<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup / device-transfer rules (android:dataExtractionRules, API 31+). The app's private
  recordings, transcripts and finished sessions live under filesDir (library/, audio/) — that audio
  is the user's private meeting content and must NOT leave the device (the whole app is "nothing is
  uploaded"). Exclude the entire file domain from both cloud backup AND device transfer; only the
  small settings (shared_prefs) still back up, so a reinstall keeps preferences without shipping
  gigabytes of private audio to Google's cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <!-- Recent sessions: meeting titles and file URIs are meeting content, not settings. -->
        <exclude domain="sharedpref" path="primeminutes_recents.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" path="primeminutes_recents.xml" />
    </device-transfer>
</data-extraction-rules>
