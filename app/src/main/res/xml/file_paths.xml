<?xml version="1.0" encoding="utf-8"?>
<!-- Exposed to other apps: the update APK (cache/updates) and shared session files (cache/shared). -->
<paths>
    <cache-path name="updates" path="updates/" />
    <cache-path name="shared" path="shared/" />
    <!-- The Share sheet's files (.pmin / PDF / audio), cleared on each share. -->
    <cache-path name="share_out" path="share_out/" />
    <!-- The Share sheet's PDF, built when the sheet opens (its size is shown). -->
    <cache-path name="share_pdf" path="share_pdf/" />
</paths>
