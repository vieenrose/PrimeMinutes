<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 counterpart of backup_rules.xml (android:fullBackupContent). Exclude all of filesDir
  (private recordings/transcripts/sessions) from Auto Backup; settings (shared_prefs) still back up.
-->
<full-backup-content>
    <exclude domain="file" />
    <!-- Recent sessions: meeting titles and file URIs are meeting content, not settings. -->
    <exclude domain="sharedpref" path="primeminutes_recents.xml" />
</full-backup-content>
