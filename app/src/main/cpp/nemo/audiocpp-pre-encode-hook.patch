     delete session;
 }
 
+audiocpp_status audiocpp_nemotron3_diar_set_external_pre_encoder(
+    audiocpp_session * session,
+    audiocpp_nemotron3_diar_pre_encode_fn fn,
+    void * user_data) {
+    if (session == nullptr) return fail(AUDIOCPP_ERR_INVALID_ARGUMENT, "session must be non-null");
+    if (session->family != "nemotron_3_diar") {
+        return fail(AUDIOCPP_ERR_INVALID_ARGUMENT,
+                    "audiocpp_nemotron3_diar_set_external_pre_encoder requires a nemotron_3_diar session");
+    }
+    return guard([&] {
+        auto * diar = dynamic_cast<engine::models::nemotron_3_diar::Session *>(session->session.get());
+        if (diar == nullptr) {
+            throw std::runtime_error("nemotron_3_diar session did not downcast to its own Session type");
+        }
+        if (fn == nullptr) {
+            diar->set_external_pre_encoder(nullptr);
+            return AUDIOCPP_OK;
+        }
+        diar->set_external_pre_encoder(
+            [fn, user_data](
+                const std::vector<float> & stacked, int64_t batch, int64_t frames,
+                int64_t stacked_dim) -> std::vector<float> {
+                float * out = nullptr;
+                int64_t out_len = 0;
+                const int rc = fn(user_data, stacked.data(), batch, frames, stacked_dim, &out, &out_len);
+                if (rc != 0 || out == nullptr) {
+                    throw std::runtime_error("nemotron_3_diar external pre-encoder callback failed");
+                }
+                std::vector<float> result(out, out + out_len);
+                std::free(out);
+                return result;
+            });
+        return AUDIOCPP_OK;
+    });
+}
