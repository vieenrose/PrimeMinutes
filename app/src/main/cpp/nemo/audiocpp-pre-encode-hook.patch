     const int64_t * valid_frames,
     float ** out_probabilities, int64_t * out_len);
 
+/*
+ * Pre-encode hook (same ownership rule as the encoder hook): fn receives the stacked mel
+ * `stacked` [batch, frames, stacked_dim] (stacked_dim = subsampling_factor * num_mel_bins, frame-major) and writes
+ * `batch * frames * hidden` floats to a malloc()'d `*out_probabilities`, with `*out_len` set to that count.
+ * A nonzero return fails the call. Pass fn == NULL to restore the library's ggml linear.
+ */
+typedef int (*audiocpp_nemotron3_diar_pre_encode_fn)(
+    void * user_data,
+    const float * stacked, int64_t batch, int64_t frames, int64_t stacked_dim,
+    float ** out_embeddings, int64_t * out_len);
+
+AUDIOCPP_API audiocpp_status audiocpp_nemotron3_diar_set_external_pre_encoder(
+    audiocpp_session * session,
+    audiocpp_nemotron3_diar_pre_encode_fn fn,
+    void * user_data);
+
 AUDIOCPP_API audiocpp_status audiocpp_nemotron3_diar_set_external_encoder(
     audiocpp_session * session,
     audiocpp_nemotron3_diar_encode_fn fn,
